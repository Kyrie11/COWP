+def _state(speed: float = 5.0):
+    import numpy as np
+
+    x = np.zeros((11,), dtype=np.float32)
+    x[3] = speed
+    x[5] = speed
+    x[6] = 0.0
+    x[7] = 4.5
+    x[8] = 1.9
+    x[10] = 1.0
+    return x
