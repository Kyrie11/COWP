+            if not current_ok:
+                continue
+            full_safe_count += 1
+            first_target = np.asarray(projected[j, 0, :5], dtype=np.float32)
+            first_accel = float(accel_hist[j, 0])
+            successor = _counterfactual_successor_agent_state(
