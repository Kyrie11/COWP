+WAYMAX_ACTION_MODE="${WAYMAX_ACTION_MODE:-absolute_xy_yaw}"
+
+INIT_CKPT="${INIT_CKPT:-outputs/cowp_v8_probe100_seed2026/checkpoints/planner/cowp_planner_best.pt}"
