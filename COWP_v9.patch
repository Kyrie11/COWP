+  else
+    resume_args=()
+    if [[ -s "$INIT_CKPT" ]]; then
+      resume_args=(--resume "$INIT_CKPT")
+    else
+      echo "[train] warning: INIT_CKPT not found: $INIT_CKPT; training from scratch is not recommended for the v9 same-root transport stage" >&2
+    fi
