+    "$PYTHON_BIN" -u -m cowp.scripts.04_eval_closed_loop \
+      --mode waymax \
+      --method "$method" \
+      --checkpoint "$CKPT" \
+      --cache-dir "$VAL_CACHE" \
+      --data-config configs/data.yaml \
+      --label-config "$label_cfg" \
+      --eval-config configs/eval.yaml \
+      --tfexample-glob "$WAYMAX_VAL" \
+      --num-shards "$shard_count" \
