+  python - "$p" "$n" "$expected" <<'PY'
+import hashlib,sys
+p,n,expected=sys.argv[1],int(sys.argv[2]),sys.argv[3]
+ids=[x.strip() for x in open(p,encoding='utf-8') if x.strip()]
